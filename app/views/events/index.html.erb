<div class="max-w-xl mx-auto px-4 py-10">
  <h1 class="text-2xl font-bold text-gray-900 mb-6">Bahá'í Events</h1>

  <%= turbo_frame_tag "new_event_form" do %>
    <%= render "new_event_form", event: @new_event %>
  <% end %>

  <div id="events" class="mt-6 flex flex-col gap-4">
    <%= render @events %>
  </div>

  <% if @events.empty? %>
    <p id="no_events" class="mt-10 text-center text-gray-400 text-sm">No events yet. Add one above!</p>
  <% end %>
</div>
