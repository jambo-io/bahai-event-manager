<div id="event_<%= event.id %>" class="bg-white rounded-2xl border border-gray-200 shadow-sm overflow-hidden" data-controller="event-edit">

  <%# Header %>
  <div class="flex items-start justify-between gap-3 px-5 pt-5 pb-4">
    <div class="flex-1 min-w-0">
      <p class="font-semibold text-gray-900 truncate text-base"><%= event.title %></p>
      <p class="text-xs text-gray-400 mt-0.5">Sacred day &middot; <%= event.date.strftime("%B %-d, %Y") %></p>
    </div>
    <%= button_to event_path(event),
        method: :delete,
        class: "shrink-0 rounded-lg p-1.5 text-gray-300 hover:text-red-400 hover:bg-red-50 transition-colors cursor-pointer",
        data: { turbo_confirm: "Remove \"#{event.title}\"?" } do %>
      <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
    <% end %>
  </div>

  <%# Saved data badges %>
  <% if event.celebration_date.present? || event.host_name.present? || event.address.present? %>
    <div class="flex flex-wrap gap-2 px-5 pb-4">
      <% if event.celebration_date.present? %>
        <span class="inline-flex items-center gap-1.5 rounded-full bg-violet-50 border border-violet-200 px-2.5 py-1 text-xs font-medium text-violet-700">
          <svg class="w-3 h-3 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M6 2a1 1 0 00-1 1v1H4a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V6a2 2 0 00-2-2h-1V3a1 1 0 10-2 0v1H7V3a1 1 0 00-1-1zm0 5a1 1 0 000 2h8a1 1 0 100-2H6z" clip-rule="evenodd"/></svg>
          <%= event.celebration_date.strftime("%b %-d, %Y") %>
        </span>
      <% end %>
      <% if event.host_name.present? %>
        <span class="inline-flex items-center gap-1.5 rounded-full bg-green-50 border border-green-200 px-2.5 py-1 text-xs font-medium text-green-700">
          <svg class="w-3 h-3 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 9a3 3 0 100-6 3 3 0 000 6zm-7 9a7 7 0 1114 0H3z" clip-rule="evenodd"/></svg>
          <%= event.host_name %>
        </span>
      <% end %>
      <% if event.address.present? %>
        <span class="inline-flex items-center gap-1.5 rounded-full bg-sky-50 border border-sky-200 px-2.5 py-1 text-xs font-medium text-sky-700">
          <svg class="w-3 h-3 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd"/></svg>
          <%= event.address %>
        </span>
      <% end %>
    </div>
  <% end %>

  <%# Edit button (default state) %>
  <div class="border-t border-gray-100 px-5 py-3 flex justify-end" data-event-edit-target="editButton">
    <button type="button"
        class="text-xs text-blue-500 hover:text-blue-700 font-medium cursor-pointer transition-colors"
        data-action="event-edit#show">
      <span class="inline-flex items-center gap-1">
        <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15.232 5.232l3.536 3.536M9 13l6.586-6.586a2 2 0 012.828 2.828L11.828 15.83a4 4 0 01-1.897 1.06l-2.796.699.699-2.796A4 4 0 019 13z"/></svg>
        Edit
      </span>
    </button>
  </div>

  <%# Edit form (hidden by default) %>
  <div class="hidden border-t border-gray-100 bg-gray-50 px-5 py-4" data-event-edit-target="form">
    <%= form_with model: event, url: event_path(event), method: :patch, class: "flex flex-col gap-3" do |f| %>
      <div>
        <label class="block text-xs font-semibold text-gray-500 uppercase tracking-wide mb-1.5">Host</label>
        <%= f.text_field :host_name,
            placeholder: "Who's hosting?",
            autocomplete: "off",
            class: "w-full rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition" %>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        <div>
          <label class="block text-xs font-semibold text-gray-500 uppercase tracking-wide mb-1.5">Sacred day date</label>
          <%= f.date_field :date,
              class: "w-full rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm text-gray-900 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition" %>
        </div>
        <div>
          <label class="block text-xs font-semibold text-gray-500 uppercase tracking-wide mb-1.5">Celebration date</label>
          <%= f.date_field :celebration_date,
              class: "w-full rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm text-gray-900 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition" %>
        </div>
      </div>
      <div>
        <label class="block text-xs font-semibold text-gray-500 uppercase tracking-wide mb-1.5">Address</label>
        <%= f.text_field :address,
            placeholder: "Where will it be held?",
            autocomplete: "off",
            class: "w-full rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition" %>
      </div>
      <div class="flex gap-2">
        <button type="button"
            class="flex-1 rounded-lg border border-gray-300 bg-white hover:bg-gray-50 text-gray-600 py-2 text-sm font-semibold cursor-pointer transition-colors"
            data-action="event-edit#hide">
          Cancel
        </button>
        <%= f.submit "Save",
            class: "flex-1 rounded-lg bg-indigo-600 hover:bg-indigo-700 text-white py-2 text-sm font-semibold cursor-pointer transition-colors" %>
      </div>
    <% end %>
  </div>
</div>
